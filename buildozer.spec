[app]
title = StudioFit
package.name = studiofit
package.domain = org.studiofit.gym
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,db,json
version = 1.0.0
requirements = python3,kivy,sqlite3,urllib3
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
p4a.branch = master

[buildozer]
log_level = 2
warn_on_root = 1
